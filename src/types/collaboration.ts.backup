// Collaboration Hub Types

export type VaultRole = 'owner' | 'contributor' | 'viewer';
export type FileType = 'pdf' | 'doc' | 'docx' | 'txt' | 'jpg' | 'jpeg' | 'png' | 'gif';
export type TaskStatus = 'pending' | 'in-progress' | 'completed';
export type TaskPriority = 'low' | 'medium' | 'high';

// Vault member interface
export interface VaultMember {
  userId: string;
  role: VaultRole;
  joinedAt?: Date | string;
  invitedBy?: string;
  name?: string;
  email?: string;
}

// Vault interfaces
export interface Vault {
  id: string;
  name: string;
  description?: string;
  isPrivate: boolean;
  tags?: string[];
  allowAlumniView: boolean;
  createdBy: string;
  createdAt: Date | string;
  updatedAt?: Date | string;
  members: VaultMember[];
  noteCount?: number;
  taskCount?: number;
}

export interface VaultCreateData {
  name: string;
  description?: string;
  isPrivate?: boolean;
  tags?: string[];
  allowAlumniView?: boolean;
}

export interface VaultUpdateData {
  name?: string;
  description?: string;
  tags?: string[];
  allowAlumniView?: boolean;
}

// Note interfaces
export interface Note {
  id: string;
  title: string;
  description?: string;
  tags?: string[];
  vaultId?: string;
  fileUrl: string;
  fileType: FileType;
  fileSize: number;
  fileName: string;
  isPublic: boolean;
  uploadedBy: string;
  uploaderName?: string;
  uploadedAt: Date | string;
  updatedAt?: Date | string;
  downloadCount?: number;
  commentCount?: number;
}

export interface NoteCreateData {
  title: string;
  description?: string;
  tags?: string[];
  vaultId?: string;
  isPublic?: boolean;
  // File data will be handled separately in upload
  file: File;
}

export interface NoteUpdateData {
  title?: string;
  description?: string;
  tags?: string[];
  isPublic?: boolean;
}

export interface NoteSearchFilters {
  query?: string;
  tags?: string[];
  vaultId?: string;
  fileType?: FileType[];
  uploadedBy?: string;
  isPublic?: boolean;
  sortBy?: 'uploadedAt' | 'title' | 'downloadCount';
  sortOrder?: 'asc' | 'desc';
  limit?: number;
  offset?: number;
}

export interface NotesResponse {
  notes: Note[];
  total: number;
  offset: number;
  limit: number;
}

// Comment interfaces
export interface Comment {
  id: string;
  noteId: string;
  content: string;
  parentId?: string;
  authorId: string;
  authorName?: string;
  createdAt: Date | string;
  updatedAt?: Date | string;
  replies?: Comment[];
}

export interface CommentCreateData {
  noteId: string;
  content: string;
  parentId?: string;
}

export interface CommentUpdateData {
  content: string;
}

// Task interfaces
export interface Task {
  id: string;
  vaultId: string;
  title: string;
  description?: string;
  status: TaskStatus;
  assignedTo?: string;
  assignedToName?: string;
  dueDate?: Date | string;
  priority: TaskPriority;
  createdBy: string;
  createdByName?: string;
  createdAt: Date | string;
  updatedAt?: Date | string;
  completedAt?: Date | string;
  completedBy?: string;
}

export interface TaskCreateData {
  vaultId: string;
  title: string;
  description?: string;
  assignedTo?: string;
  dueDate?: Date | string;
  priority?: TaskPriority;
}

export interface TaskUpdateData {
  title?: string;
  description?: string;
  status?: TaskStatus;
  assignedTo?: string;
  dueDate?: Date | string;
  priority?: TaskPriority;
}

// API Response wrappers
export interface ApiResponse<T> {
  success?: boolean;
  error?: string;
  data?: T;
  message?: string;
}

// File upload interfaces
export interface FileUploadData {
  fileName: string;
  fileData: string; // base64
  fileType: string;
  fileSize: number;
}

export interface FileUploadResponse {
  success: boolean;
  fileUrl: string;
  fileName: string;
  filePath: string;
  message: string;
}

// Utility types for form handling
export interface VaultFormData extends VaultCreateData {}
export interface NoteFormData extends Omit<NoteCreateData, 'file'> {
  file?: File;
}
export interface TaskFormData extends TaskCreateData {}

// Dashboard integration types
export interface CollaborationStats {
  totalVaults: number;
  activeVaults: number;
  totalNotes: number;
  notesUploaded: number;
  tasksAssigned: number;
  tasksPending: number;
}

export interface RecentActivity {
  id: string;
  type: 'note_uploaded' | 'vault_created' | 'task_completed' | 'comment_added';
  title: string;
  description: string;
  createdAt: Date | string;
  userId: string;
  userName: string;
}

// Constants
export const FILE_TYPES: FileType[] = ['pdf', 'doc', 'docx', 'txt', 'jpg', 'jpeg', 'png', 'gif'];
export const TASK_STATUSES: TaskStatus[] = ['pending', 'in-progress', 'completed'];
export const TASK_PRIORITIES: TaskPriority[] = ['low', 'medium', 'high'];
export const VAULT_ROLES: VaultRole[] = ['owner', 'contributor', 'viewer'];

export const FILE_TYPE_LABELS: Record<FileType, string> = {
  pdf: 'PDF Document',
  doc: 'Word Document',
  docx: 'Word Document',
  txt: 'Text File',
  jpg: 'JPEG Image',
  jpeg: 'JPEG Image',
  png: 'PNG Image',
  gif: 'GIF Image'
};

export const TASK_STATUS_LABELS: Record<TaskStatus, string> = {
  pending: 'Pending',
  'in-progress': 'In Progress',
  completed: 'Completed'
};

export const TASK_PRIORITY_LABELS: Record<TaskPriority, string> = {
  low: 'Low',
  medium: 'Medium',
  high: 'High'
};

export const VAULT_ROLE_LABELS: Record<VaultRole, string> = {
  owner: 'Owner',
  contributor: 'Contributor',
  viewer: 'Viewer'
};

// Helper functions for type checking and validation
export function isValidFileType(type: string): type is FileType {
  return FILE_TYPES.includes(type as FileType);
}

export function isValidTaskStatus(status: string): status is TaskStatus {
  return TASK_STATUSES.includes(status as TaskStatus);
}

export function isValidTaskPriority(priority: string): priority is TaskPriority {
  return TASK_PRIORITIES.includes(priority as TaskPriority);
}

export function isValidVaultRole(role: string): role is VaultRole {
  return VAULT_ROLES.includes(role as VaultRole);
}

// File size formatting utility
export function formatFileSize(bytes: number): string {
  if (bytes === 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}