// TASK API FUNCTIONS
export const taskService = {
  // Get all tasks for a vault
  async getTasks(vaultId: string): Promise<Task[]> {
    try {
      const response = await api.get<{ tasks: Task[] }>('/tasks', {
        params: { vaultId },
      });
      return response.data.tasks;
    } catch (error: any) {
      console.error('[taskService] Failed to fetch tasks:', error.message);
      if (error.response?.status === 403) {
        console.error('[taskService] Access denied - check if user is logged in and has vault access');
      }
      throw error;
    }
  },

  // Get a specific task by ID
  async getTask(id: string): Promise<Task> {
    const response = await api.get<{ task: Task }>(`/tasks/${id}`);
    return response.data.task;
  },

  // Create a new task
  async createTask(taskData: TaskCreateData): Promise<Task> {
    const response = await api.post<{ task: Task }>('/tasks', taskData);
    return response.data.task;
  },

  // Update a task
  async updateTask(id: string, updateData: TaskUpdateData): Promise<Task> {
    const response = await api.put<{ task: Task }>(`/tasks/${id}`, updateData);
    return response.data.task;
  },

  // Delete a task
  async deleteTask(id: string): Promise<void> {
    await api.delete(`/tasks/${id}`);
  },
};

// FILE API FUNCTIONS
export const fileService = {
  // Upload a file
  async uploadFile(fileData: FileUploadData): Promise<FileUploadResponse> {
    const response = await api.post<FileUploadResponse>('/upload/file', fileData);
    return response.data;
  },
};
