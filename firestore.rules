rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'harsha.talatala@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    // Allow unauthenticated writes to pendingRegistrations for user registration
    // Allow admins to read/update/delete pending registrations  
    // Allow unauthenticated reads for sign-in flow (users checking their registration status)
    match /pendingRegistrations/{document} {
      allow create: if true; // Allow anyone to submit registration
      allow read: if true; // Allow reading for sign-in flow - we'll validate email match in app logic
      allow update, delete: if isAdmin();
    }
    
    // Users collection - only authenticated users can read their own data
    // Admins can read all user data
    // Users can create their own user document during account recovery
    match /users/{userId} {
      allow read: if request.auth != null && 
        (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if isAdmin();
    }
    
    // Students collection - authenticated users can read all student data
    // Admins can read/write all student data
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Alumni collection - authenticated users can read all alumni data
    // Admins can read/write all alumni data
    match /alumni/{alumniId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Events collection - authenticated users can read
    // Admins can read/write
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Event registrations - users can create their own registrations
    // Admins can read/write all registrations
    match /eventRegistrations/{registrationId} {
      allow create: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if isAdmin();
    }
    
    // Collaboration Hub Collections
    
    // Notes collection - users can read/write their own notes and public notes
    // Team members can read/write shared notes
    match /notes/{noteId} {
      allow read: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        resource.data.isPublic == true ||
        isAdmin()
      );
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.authorId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        isAdmin()
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        isAdmin()
      );
    }
    
    // Teams collection - authenticated users can create teams
    // Team members can read team data
    match /teams/{teamId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        isAdmin()
      );
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.createdBy;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        isAdmin() ||
        (
          resource.data.members != null && (
            (resource.data.members.size() > 0 && resource.data.members[0].userId == request.auth.uid && (resource.data.members[0].teamRole == 'owner' || resource.data.members[0].teamRole == 'admin')) ||
            (resource.data.members.size() > 1 && resource.data.members[1].userId == request.auth.uid && (resource.data.members[1].teamRole == 'owner' || resource.data.members[1].teamRole == 'admin')) ||
            (resource.data.members.size() > 2 && resource.data.members[2].userId == request.auth.uid && (resource.data.members[2].teamRole == 'owner' || resource.data.members[2].teamRole == 'admin')) ||
            (resource.data.members.size() > 3 && resource.data.members[3].userId == request.auth.uid && (resource.data.members[3].teamRole == 'owner' || resource.data.members[3].teamRole == 'admin')) ||
            (resource.data.members.size() > 4 && resource.data.members[4].userId == request.auth.uid && (resource.data.members[4].teamRole == 'owner' || resource.data.members[4].teamRole == 'admin')) ||
            (resource.data.members.size() > 5 && resource.data.members[5].userId == request.auth.uid && (resource.data.members[5].teamRole == 'owner' || resource.data.members[5].teamRole == 'admin')) ||
            (resource.data.members.size() > 6 && resource.data.members[6].userId == request.auth.uid && (resource.data.members[6].teamRole == 'owner' || resource.data.members[6].teamRole == 'admin')) ||
            (resource.data.members.size() > 7 && resource.data.members[7].userId == request.auth.uid && (resource.data.members[7].teamRole == 'owner' || resource.data.members[7].teamRole == 'admin')) ||
            (resource.data.members.size() > 8 && resource.data.members[8].userId == request.auth.uid && (resource.data.members[8].teamRole == 'owner' || resource.data.members[8].teamRole == 'admin')) ||
            (resource.data.members.size() > 9 && resource.data.members[9].userId == request.auth.uid && (resource.data.members[9].teamRole == 'owner' || resource.data.members[9].teamRole == 'admin'))
          )
        )
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        isAdmin()
      );
    }
    
    // Activities collection - authenticated users can read their activities
    // Users can create activities for their actions
    match /activities/{activityId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin();
    }
    
    // Comments collection - authenticated users can read/create comments
    // Comment authors can update/delete their comments
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.authorId;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        isAdmin()
      );
    }
    
    // Files collection - authenticated users can upload/access files
    match /files/{fileId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uploadedBy ||
        resource.data.isPublic == true ||
        isAdmin()
      );
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.uploadedBy;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.uploadedBy ||
        isAdmin()
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.uploadedBy ||
        isAdmin()
      );
    }
    
    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}