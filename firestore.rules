rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'harsha.talatala@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    // Allow unauthenticated writes to pendingRegistrations for user registration
    // Allow admins to read/update/delete pending registrations
    match /pendingRegistrations/{document} {
      allow create: if true; // Allow anyone to submit registration
      allow read, update, delete: if isAdmin();
    }
    
    // Users collection - only authenticated users can read their own data
    // Admins can read all user data
    match /users/{userId} {
      allow read: if request.auth != null && 
        (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
    
    // Students collection - authenticated users can read their own data
    // Admins can read/write all student data
    match /students/{studentId} {
      allow read: if request.auth != null && 
        (request.auth.uid == studentId || isAdmin());
      allow write: if isAdmin();
    }
    
    // Alumni collection - authenticated users can read their own data
    // Admins can read/write all alumni data
    match /alumni/{alumniId} {
      allow read: if request.auth != null && 
        (request.auth.uid == alumniId || isAdmin());
      allow write: if isAdmin();
    }
    
    // Events collection - authenticated users can read
    // Admins can read/write
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Event registrations - users can create their own registrations
    // Admins can read/write all registrations
    match /eventRegistrations/{registrationId} {
      allow create: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if isAdmin();
    }
    
    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}