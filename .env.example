# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# API Configuration
VITE_API_BASE_URL=https://your-api-domain.com/api

# Azure Blob Storage Configuration
VITE_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account_name;AccountKey=your_account_key;EndpointSuffix=core.windows.net
VITE_AZURE_STORAGE_ACCOUNT_NAME=your_account_name
VITE_AZURE_STORAGE_ACCOUNT_KEY=your_account_key
VITE_AZURE_STORAGE_CONTAINER_NAME=collaboration-files

# Development
NODE_ENV=development