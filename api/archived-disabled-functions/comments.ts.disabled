import { app, HttpRequest, HttpResponseInit, InvocationContext } from '@azure/functions';
import { getFirestore } from 'firebase-admin/firestore';
import { initializeApp, cert, getApps } from 'firebase-admin/app';
import { Comment, ApiResponse, PaginatedResponse, Activity } from '../types';

// Initialize Firebase Admin if not already initialized
if (getApps().length === 0) {
  initializeApp({
    credential: cert({
      projectId: process.env.FIREBASE_PROJECT_ID,
      clientEmail: process.env.FIREBASE_CLIENT_EMAIL,
      privateKey: process.env.FIREBASE_PRIVATE_KEY?.replace(/\\n/g, '\n'),
    }),
  });
}

const db = getFirestore();

// Helper function to create activity log
async function createActivity(
  userId: string,
  userName: string,
  userRole: string,
  type: string,
  entityId: string,
  entityType: string,
  description: string,
  metadata?: any
) {
  const activity: Activity = {
    userId,
    userName,
    userRole: userRole as 'student' | 'alumni' | 'admin',
    type: type as any,
    entityId,
    entityType: entityType as any,
    description,
    metadata,
    createdAt: new Date()
  };

  await db.collection('activities').add(activity);
}

// Helper function to build comment tree
function buildCommentTree(comments: Comment[]): Comment[] {
  const commentMap = new Map<string, Comment>();
  const rootComments: Comment[] = [];

  // First pass: create map of all comments
  comments.forEach(comment => {
    commentMap.set(comment.id!, { ...comment, replies: [] });
  });

  // Second pass: build tree structure
  comments.forEach(comment => {
    const commentObj = commentMap.get(comment.id!)!;
    if (comment.parentCommentId) {
      const parent = commentMap.get(comment.parentCommentId);
      if (parent) {
        parent.replies!.push(commentObj);
      }
    } else {
      rootComments.push(commentObj);
    }
  });

  return rootComments;
}

// GET /api/comments - Get comments for a note
async function getComments(request: HttpRequest, context: InvocationContext): Promise<HttpResponseInit> {
  try {
    const url = new URL(request.url);
    const noteId = url.searchParams.get('noteId');
    const page = parseInt(url.searchParams.get('page') || '1');
    const limit = parseInt(url.searchParams.get('limit') || '50');

    if (!noteId) {
      return {
        status: 400,
        headers: {
          'Content-Type': 'application/json',
          'Access-Control-Allow-Origin': '*'
        },
        body: JSON.stringify({
          success: false,
          error: 'Note ID is required'
        })
      };
    }

    const query = db.collection('comments')
      .where('noteId', '==', noteId)
      .orderBy('createdAt', 'asc');

    // Get total count
    const countSnapshot = await query.get();
    const total = countSnapshot.size;

    // Apply pagination
    const offset = (page - 1) * limit;
    const snapshot = await query.offset(offset).limit(limit).get();

    const comments: Comment[] = [];
    snapshot.forEach((doc) => {
      const data = doc.data();
      comments.push({
        id: doc.id,
        ...data,
        createdAt: data.createdAt?.toDate(),
        updatedAt: data.updatedAt?.toDate(),
      } as Comment);
    });

    // Build comment tree
    const commentTree = buildCommentTree(comments);

    const response: PaginatedResponse<Comment> = {
      success: true,
      data: commentTree,
      pagination: {
        page,
        limit,
        total,
        totalPages: Math.ceil(total / limit)
      }
    };

    return {
      status: 200,
      headers: {
        'Content-Type': 'application/json',
        'Access-Control-Allow-Origin': '*',
        'Access-Control-Allow-Headers': '*',
        'Access-Control-Allow-Methods': '*'
      },
      body: JSON.stringify(response)
    };
  } catch (error: any) {
    context.error('Error getting comments:', error);
    return {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        'Access-Control-Allow-Origin': '*'
      },
      body: JSON.stringify({
        success: false,
        error: 'Internal server error'
      })
    };
  }
}

// POST /api/comments - Create a new comment
async function createComment(request: HttpRequest, context: InvocationContext): Promise<HttpResponseInit> {
  try {
    const body = await request.json() as Partial<Comment>;
    
    if (!body.noteId || !body.content || !body.authorId || !body.authorName) {
      return {
        status: 400,
        headers: {
          'Content-Type': 'application/json',
          'Access-Control-Allow-Origin': '*'
        },
        body: JSON.stringify({
          success: false,
          error: 'Note ID, content, authorId, and authorName are required'
        })
      };
    }

    // Verify note exists
    const noteDoc = await db.collection('notes').doc(body.noteId).get();
    if (!noteDoc.exists) {
      return {
        status: 404,
        headers: {
          'Content-Type': 'application/json',
          'Access-Control-Allow-Origin': '*'
        },
        body: JSON.stringify({
          success: false,
          error: 'Note not found'
        })
      };
    }

    // If it's a reply, verify parent comment exists
    if (body.parentCommentId) {
      const parentDoc = await db.collection('comments').doc(body.parentCommentId).get();
      if (!parentDoc.exists) {
        return {
          status: 404,
          headers: {
            'Content-Type': 'application/json',
            'Access-Control-Allow-Origin': '*'
          },
          body: JSON.stringify({
            success: false,
            error: 'Parent comment not found'
          })
        };
      }
    }

    const now = new Date();
    const comment: Omit<Comment, 'id'> = {
      noteId: body.noteId,
      authorId: body.authorId,
      authorName: body.authorName,
      authorRole: body.authorRole || 'student',
      content: body.content,
      parentCommentId: body.parentCommentId,
      createdAt: now,
    };

    const docRef = await db.collection('comments').add(comment);

    // Create activity log
    const noteData = noteDoc.data();
    await createActivity(
      comment.authorId,
      comment.authorName,
      comment.authorRole,
      'comment_added',
      docRef.id,
      'comment',
      `Added comment on "${noteData?.title || 'Unknown note'}"`,
      { noteId: comment.noteId, parentCommentId: comment.parentCommentId }
    );

    const response: ApiResponse<{ id: string }> = {
      success: true,
      data: { id: docRef.id },
      message: 'Comment created successfully'
    };

    return {
      status: 201,
      headers: {
        'Content-Type': 'application/json',
        'Access-Control-Allow-Origin': '*'
      },
      body: JSON.stringify(response)
    };
  } catch (error: any) {
    context.error('Error creating comment:', error);
    return {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        'Access-Control-Allow-Origin': '*'
      },
      body: JSON.stringify({
        success: false,
        error: 'Internal server error'
      })
    };
  }
}

// PUT /api/comments/{id} - Update a comment
async function updateComment(request: HttpRequest, context: InvocationContext): Promise<HttpResponseInit> {
  try {
    const commentId = request.params.id;
    if (!commentId) {
      return {
        status: 400,
        headers: {
          'Content-Type': 'application/json',
          'Access-Control-Allow-Origin': '*'
        },
        body: JSON.stringify({
          success: false,
          error: 'Comment ID is required'
        })
      };
    }

    const body = await request.json() as { content: string };
    
    if (!body.content) {
      return {
        status: 400,
        headers: {
          'Content-Type': 'application/json',
          'Access-Control-Allow-Origin': '*'
        },
        body: JSON.stringify({
          success: false,
          error: 'Content is required'
        })
      };
    }

    const commentDoc = await db.collection('comments').doc(commentId).get();
    if (!commentDoc.exists) {
      return {
        status: 404,
        headers: {
          'Content-Type': 'application/json',
          'Access-Control-Allow-Origin': '*'
        },
        body: JSON.stringify({
          success: false,
          error: 'Comment not found'
        })
      };
    }

    await db.collection('comments').doc(commentId).update({
      content: body.content,
      updatedAt: new Date()
    });

    const response: ApiResponse<null> = {
      success: true,
      message: 'Comment updated successfully'
    };

    return {
      status: 200,
      headers: {
        'Content-Type': 'application/json',
        'Access-Control-Allow-Origin': '*'
      },
      body: JSON.stringify(response)
    };
  } catch (error: any) {
    context.error('Error updating comment:', error);
    return {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        'Access-Control-Allow-Origin': '*'
      },
      body: JSON.stringify({
        success: false,
        error: 'Internal server error'
      })
    };
  }
}

// DELETE /api/comments/{id} - Delete a comment
async function deleteComment(request: HttpRequest, context: InvocationContext): Promise<HttpResponseInit> {
  try {
    const commentId = request.params.id;
    if (!commentId) {
      return {
        status: 400,
        headers: {
          'Content-Type': 'application/json',
          'Access-Control-Allow-Origin': '*'
        },
        body: JSON.stringify({
          success: false,
          error: 'Comment ID is required'
        })
      };
    }

    const commentDoc = await db.collection('comments').doc(commentId).get();
    if (!commentDoc.exists) {
      return {
        status: 404,
        headers: {
          'Content-Type': 'application/json',
          'Access-Control-Allow-Origin': '*'
        },
        body: JSON.stringify({
          success: false,
          error: 'Comment not found'
        })
      };
    }

    // Delete comment and all its replies
    const batch = db.batch();
    
    // Get all replies to this comment
    const repliesSnapshot = await db.collection('comments')
      .where('parentCommentId', '==', commentId)
      .get();
    
    // Delete all replies
    repliesSnapshot.forEach((replyDoc) => {
      batch.delete(replyDoc.ref);
    });
    
    // Delete the main comment
    batch.delete(commentDoc.ref);
    
    await batch.commit();

    const response: ApiResponse<null> = {
      success: true,
      message: 'Comment and replies deleted successfully'
    };

    return {
      status: 200,
      headers: {
        'Content-Type': 'application/json',
        'Access-Control-Allow-Origin': '*'
      },
      body: JSON.stringify(response)
    };
  } catch (error: any) {
    context.error('Error deleting comment:', error);
    return {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        'Access-Control-Allow-Origin': '*'
      },
      body: JSON.stringify({
        success: false,
        error: 'Internal server error'
      })
    };
  }
}

// Register HTTP functions
app.http('comments-get', {
  methods: ['GET'],
  route: 'comments',
  authLevel: 'anonymous',
  handler: getComments
});

app.http('comments-post', {
  methods: ['POST'],
  route: 'comments',
  authLevel: 'anonymous',
  handler: createComment
});

app.http('comment-put', {
  methods: ['PUT'],
  route: 'comments/{id}',
  authLevel: 'anonymous',
  handler: updateComment
});

app.http('comment-delete', {
  methods: ['DELETE'],
  route: 'comments/{id}',
  authLevel: 'anonymous',
  handler: deleteComment
});

// Handle OPTIONS requests for CORS
app.http('comments-options', {
  methods: ['OPTIONS'],
  route: 'comments',
  authLevel: 'anonymous',
  handler: async () => ({
    status: 200,
    headers: {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Headers': '*',
      'Access-Control-Allow-Methods': '*'
    }
  })
});

app.http('comment-options', {
  methods: ['OPTIONS'],
  route: 'comments/{id}',
  authLevel: 'anonymous',
  handler: async () => ({
    status: 200,
    headers: {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Headers': '*',
      'Access-Control-Allow-Methods': '*'
    }
  })
});